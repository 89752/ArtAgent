
DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_MODEL=deepseek-v4-flash-0731

SEMART_DATA_DIR=./SemArt
INDEX_DIR=./data/index

TAVILY_API_KEY=your-api-key-here
DEFAULT_DATASET=core
VISION_MODEL=qwen3.5-omni-plus-2026-03-15

# MinerU 精确解析（PDF 文字层）：配置 TOKEN 后启用，未配置时回落 pdfplumber
MINERU_TOKEN=your-mineru-token
# 扫描页 OCR 开关：默认 1（开启），设为 0 时扫描页保持纯整页图像路线
MINERU_OCR=1

# ── 模型降级（G9/2.5）：主模型失败自动切备份；留空 = 不降级 ──
LLM_BACKUP_MODEL=
LLM_BACKUP_BASE_URL=
LLM_BACKUP_API_KEY=
VISION_BACKUP_MODEL=
VISION_BACKUP_BASE_URL=
VISION_BACKUP_API_KEY=

# ── 记忆系统（Phase 1.5 自动抽取，默认关）──
MEMORY_USER_ID=default_user     # 工具层记忆身份（评估用 eval-test）
MEMORY_AUTO_EXTRACT=0           # 1 = 开启自动抽取（对标 ChatGPT Dreaming）
MEMORY_EXTRACT_INTERVAL=2       # 每 N 轮对话抽取一次
MEMORY_SMART_MERGE=0            # 1 = 语义冲突解析（REPLACE/MERGE/SKIP）+ 守卫规范化
MEMORY_MAX_ITEMS_PER_USER=200   # 单用户记忆条目上限（超出按重要性×新鲜度淘汰）
MEMORY_MAX_CHARS_PER_USER=40000 # 单用户记忆总字符上限（0 = 只按条目数限制）
MEMORY_PROFILE_REFRESH=0        # 1 = 跨线程用户画像聚合（ChatGPT 式"记住你"）
MEMORY_PROFILE_MAX_AGE_DAYS=7   # 画像刷新间隔（天）
MEMORY_VECTOR_BACKEND=sqlite    # sqlite（默认全量打分）| chroma（可选向量加速）

# ── 精排（Stage 4 双端点接力 + 本地兜底）──
# 全本地质量方案（2026-08-03）：RERANK_BACKEND=local +
# RERANK_LOCAL_MODEL=jinaai/jina-reranker-v3.5（0.6B listwise，非商用许可 OK）
# 三条出路：
#   1. RERANK_ENABLED=0       关闭精排（粗排 Recall@5 85%，全离线）
#   2. RERANK_BACKEND=local   本地精排（Jina v3.5 默认；bge-reranker-v2-m3 兼容）
#   3. RERANK_API_URL/KEY     指向其他 OpenAI 兼容 rerank 服务
RERANK_MODEL=qwen3-rerank
RERANK_FALLBACK_MODEL=gte-rerank-v2
RERANK_BACKEND=api             # api | local
RERANK_LOCAL_MODEL=jinaai/jina-reranker-v3.5   # 或 BAAI/bge-reranker-v2-m3
# 接 Jina（免费额度 10M tokens）：RERANK_MODEL=jina-reranker-v3，
# RERANK_API_URL=https://api.jina.ai/v1/rerank，RERANK_API_KEY=jina_xxx，
# 并把 RERANK_FALLBACK_MODEL 留空（避免跨厂商混合）。
RERANK_API_URL=
RERANK_API_KEY=
RERANK_ENABLED=1               # 0 = 关闭精排
RERANK_POOL=40                 # 精排候选池（本地精排嫌慢可调小，如 15）

# ── 并发与限流（G7/2.3）──
TASK_PARSE_CONCURRENCY=2        # 同时最多 N 个文档解析任务
RATE_LIMIT_RPM=60               # 每 IP 每分钟请求数（0 = 关闭限流）
RATE_LIMIT_BURST=20             # 桶容量/突发上限

# ── 工具执行治理（G6/2.2）──
TOOL_TIMEOUT_SEC=60             # 单次工具调用超时
TOOL_RETRIES=1                  # 瞬时失败重试次数

# ── 成本估算（G8/2.4，单价为 0 时关闭估算）──
COST_PER_1K_INPUT_TOKENS=0
COST_PER_1K_OUTPUT_TOKENS=0

# ── 部署与运行环境（G11/3.5）──
ARTAGENT_ENV=dev                # dev / test / prod（日志与参数分级预留）
