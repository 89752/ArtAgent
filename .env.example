
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=your-llm-base-url        # OpenAI 兼容端点，不预设平台
LLM_MODEL=your-llm-model

INDEX_DIR=./data/index

TAVILY_API_KEY=your-api-key-here
DEFAULT_DATASET=core
VISION_API_KEY=your-api-key-here      # 缺省回落 LLM_API_KEY
VISION_BASE_URL=your-vision-base-url  # 缺省回落 LLM_BASE_URL
VISION_MODEL=your-vision-model        # 缺省回落 LLM_MODEL（LLM_MODEL 需支持图像输入）

# ── 评估裁判模型（llm-as-judge，缺省同对话模型）──
JUDGE_MODEL=your-judge-model
JUDGE_API_KEY=your-api-key-here       # 缺省回落 LLM_API_KEY
JUDGE_BASE_URL=your-judge-base-url    # 缺省回落 LLM_BASE_URL

# ── P2 多模型角色（均可省略，安全回落 LLM_*）──
CHEAP_MODEL=your-cheap-model          # 快速任务 / 检索改写 / 相关性过滤；未配置时回落 LLM_MODEL
CHEAP_API_KEY=your-api-key-here
CHEAP_BASE_URL=your-cheap-base-url
REASONING_MODEL=your-reasoning-model  # 复杂多步骤任务：对比 / 时间线 / 研究
REASONING_API_KEY=your-api-key-here
REASONING_BASE_URL=your-reasoning-base-url
MODEL_ROUTING_ENABLED=1       # 0 = 全部回退主模型，用于成本/质量 A-B 对照
AGENTIC_RAG_ENABLED=1         # 0 = 关闭二次改写检索，保留普通检索
AGENTIC_RAG_MIN_EVIDENCE=3

# ── 用户 PDF 整页图检索的嵌入模型（文搜图）──
PDF_IMAGE_EMBED_PROVIDER=dashscope    # dashscope（默认）| openai（OpenAI 兼容 /embeddings）
PDF_IMAGE_EMBED_MODEL=tongyi-embedding-vision-plus
PDF_IMAGE_EMBED_API_KEY=your-api-key-here     # 缺省回落 LLM_API_KEY
PDF_IMAGE_EMBED_BASE_URL=your-embed-base-url  # openai 必填；缺省回落 LLM_BASE_URL

# MinerU 精确解析（PDF 文字层）：配置 TOKEN 后启用，未配置时回落 pdfplumber
MINERU_TOKEN=your-mineru-token
# 扫描页 OCR 开关：默认 1（开启），设为 0 时扫描页保持纯整页图像路线
MINERU_OCR=1
# 上传大小上限（MB）：超过后 PDF 可让用户选择“拆分上传”或“pdfplumber 直接传”
UPLOAD_MAX_MB=50

# ── 用户图片上传与绘画分析 ──
USER_IMAGE_MAX_MB=20          # 单张图片大小上限（jpg/png/webp）
USER_IMAGE_TTL_DAYS=30        # 图片与分析结果保留天数，超期启动时清理

# ── 记忆系统（代码默认开启；显式设 0 可关闭）──
MEMORY_USER_ID=web_user         # 匿名兜底记忆身份；登录后按账号隔离（请求级 ContextVar 优先）
MEMORY_AUTO_EXTRACT=1           # 1 = 开启自动抽取
MEMORY_EXTRACT_INTERVAL=2       # 每 N 轮对话抽取一次
MEMORY_SMART_MERGE=1            # 1 = 语义冲突解析（REPLACE/MERGE/SKIP）+ 守卫规范化
MEMORY_MAX_ITEMS_PER_USER=200   # 单用户记忆条目上限（超出按重要性×新鲜度淘汰）
MEMORY_MAX_CHARS_PER_USER=40000 # 单用户记忆总字符上限（0 = 只按条目数限制）
MEMORY_PROFILE_REFRESH=1        # 1 = 跨线程用户画像聚合（ChatGPT 式"记住你"）
MEMORY_PROFILE_MAX_AGE_DAYS=7   # 画像刷新间隔（天）
MEMORY_VECTOR_BACKEND=sqlite    # sqlite（默认全量打分）| chroma（可选向量加速）

# ── 精排（Jina Reranker v3.5 API）──
RERANK_MODEL=jina-reranker-v3.5   # Jina 精排模型（默认即可）
RERANK_API_KEY=your-api-key-here  # Jina API Key（未配置时精排降级为粗排原序）
RERANK_ENABLED=1                # 0 = 关闭精排
RERANK_POOL=20                  # 精排候选池大小
RERANK_TIMEOUT_SECONDS=8        # 精排最长等待；失败立即降级到粗排
RERANK_MAX_RETRIES=0            # 精排是可选增强，默认不重试阻塞主链路

# ── 词法检索（向量检索的补充通道）──
LEXICAL_ENABLED=1               # 1 = core FTS5 + PDF BM25 参与 RRF 融合
LEXICAL_TRANSLATE=1             # 1 = 查询语言与索引语言不一致时按需翻译

# ── 并发与限流 ──
TASK_PARSE_CONCURRENCY=2        # 共享任务库内同时最多 N 个文档解析任务
TASK_PARSE_TIMEOUT_SEC=1800     # 单次解析执行预算（秒）
RATE_LIMIT_RPM=60               # 每 IP 每分钟请求数（0 = 关闭限流）
RATE_LIMIT_BURST=20             # 桶容量/突发上限

# ── 工具执行治理（G6/2.2）──
TOOL_TIMEOUT_SEC=60             # 单次工具调用超时
TOOL_RETRIES=1                  # 瞬时失败重试次数

# ── 成本估算（G8/2.4，单价为 0 时关闭估算）──
COST_PER_1K_INPUT_TOKENS=0
COST_PER_1K_OUTPUT_TOKENS=0

# ── 旧单机模式（默认关闭；共享部署勿开启）──
# ARTAGENT_SEED_DEFAULT_ACCOUNT=1  # =1 时创建默认管理员 user/11111111

# ── 持久任务与资源边界 ──
ARTAGENT_JOB_EXECUTION=process   # 默认独立进程；inline 仅供调试，不能强制终止线程
ARTAGENT_STREAM_EXECUTION=process # 对话/图像分析同样使用受监护进程；inline 仅供调试
RUN_MAX_INPUT_TOKENS=24000       # 完整模型请求的估算输入上限（包含工具 schema）
UPLOAD_HARD_MAX_MB=200           # 所有 PDF 模式均不可绕过
UPLOAD_MAX_PDF_PAGES=500
UPLOAD_MAX_SPLIT_PARTS=20
UPLOAD_USER_CONCURRENCY=2
UPLOAD_USER_MAX_DOCUMENTS=200
UPLOAD_USER_STORAGE_MB=2048      # 每次上传先预留硬上限对应的空间
UPLOAD_USER_PENDING_LIMIT=10
SESSION_TTL_SECONDS=604800      # 浏览器登录会话 7 天到期；普通 API Key 仍需显式撤销
INDEX_VERSION_GRACE_SECONDS=86400 # 旧/失败索引版本保留 24 小时后回收；生效版本不回收
